generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  fan          Fan?
  profile      MemberProfile?
  messages     ChatMessage[]
  resetTokens  PasswordResetToken[]
}

model Product {
  id                 String        @id @default(cuid())
  name               String
  description        String
  icon               String?
  price              Int
  isFree             Boolean       @default(false)
  isNew              Boolean       @default(false)
  requiresMembership String?
  artifactUrl        String?
  githubUrl          String?
  showGithub         Boolean       @default(false)
  vercelUrl          String?
  gradient           String        @default("linear-gradient(160deg,#7c6cff,#3a1d6e)")
  order              Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
}

model Membership {
  id           String        @id @default(cuid())
  tier         String        @unique
  name         String
  price        Int
  description  String
  features     String[]
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscribers  Transaction[]
}

model Transaction {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount       Int
  stripeId     String?     @unique
  status       String      @default("pending")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Fan {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSpent     Int      @default(0)
  displayName    String
  initials       String
  avatarColor    String
  membershipTier String?
  rank           Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProjectRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  title       String
  description String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  path      String   @default("/")
  country   String?
  city      String?
  browser   String?
  device    String?
  createdAt DateTime @default(now())
}

model MemberProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String?
  bio           String?
  designation   String?
  cvUrl         String?
  profilePicUrl String?
  repos         String[]
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  fromAdmin Boolean  @default(false)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  html      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model SecurityTool {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("🛡️")
  category  String
  language  String
  stars     String
  description String
  githubUrl String
  demoUrl   String?
  gradient  String   @default("linear-gradient(135deg,#1e3a8a,#1a3270)")
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
